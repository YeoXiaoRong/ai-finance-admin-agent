# ============================================================
# AI Finance Admin Agent — Environment Variables
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# --- API Authentication ---
# REQUIRED. A strong random secret used to authenticate API callers via the
# X-API-Key request header.  If this variable is missing or blank the server
# will reject every protected request with HTTP 401.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
FINANCE_API_KEY=your-secret-api-key-here

# --- Flask + Download Token Signing ---
# Required. Used for Flask session signing AND as the HMAC-SHA256 signing key
# for short-lived browser download tokens.  Must be kept secret.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-flask-secret-key-here

# --- Public base URL ---
# The public HTTPS base URL of this server, used to build absolute download_url
# values in API responses.  Set this to your ngrok tunnel address (no trailing
# slash) so that IBM watsonx Orchestrate receives a fully-qualified link.
# Falls back to http://127.0.0.1:5000 when unset (local development only).
# Example: https://clutch-untying-outdoors.ngrok-free.dev
PUBLIC_BASE_URL=https://your-ngrok-subdomain.ngrok-free.app
